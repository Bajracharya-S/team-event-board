<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Project Starter</title>
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<style type="text/tailwindcss">
  @variant dark (&:where(.dark, .dark *));
</style>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
<script src="https://unpkg.com/htmx.org@2.0.4"></script>
<script>
  if (localStorage.theme === 'dark') {
    document.documentElement.classList.add('dark');
  }
  function toggleDark() {
    document.documentElement.classList.toggle('dark');
    localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    window.dispatchEvent(new Event('darkmode-changed'));
  }
</script>
</head>
<body class="min-h-screen bg-gradient-to-b from-slate-50 to-slate-100 dark:bg-none dark:bg-slate-950 dark:text-slate-100 text-slate-900 p-6">
<div class="max-w-5xl mx-auto">
<nav class="flex items-center justify-between gap-3 mb-6 flex-wrap">
  <a
    href="<%= session?.authenticatedUser ? '/home' : '/login' %>"
    class="inline-flex items-center gap-2.5 px-4 py-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-lg font-bold text-slate-900 dark:text-white no-underline"
  >
    <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-b from-blue-400 to-blue-600"></span>
    Event Board
    
  </a>

  
  <div class="flex items-center gap-3 flex-wrap">
    
    <% if (session?.authenticatedUser) { %>
      <% if (session.authenticatedUser.role === "admin") { %>
        <a href="/admin/users" class="text-blue-600 dark:text-blue-400 font-semibold no-underline hover:underline">Manage Users</a>
      <% } %>
      <% if (session.authenticatedUser.role === "admin" || session.authenticatedUser.role === "staff") { %>
        <a href="/events/new" class="text-blue-600 dark:text-blue-400 font-semibold no-underline hover:underline">Create Event</a>
      <% } %>
      <a href="/events" class="text-blue-600 dark:text-blue-400 font-semibold no-underline hover:underline">Events</a>
      <a href="/archive" class="text-blue-600 dark:text-blue-400 font-semibold no-underline hover:underline">Archive</a>
      <% if (session.authenticatedUser.role === "user") { %>
        <a href="/profile/saved" class="text-blue-600 dark:text-blue-400 font-semibold no-underline hover:underline">Saved Events</a>
      <% } %>
      <span class="text-slate-500 dark:text-slate-400">
        Signed in as <strong class="text-slate-700 dark:text-slate-200"><%= session.authenticatedUser.displayName %></strong>
        (<%= session.authenticatedUser.role %>)
      </span>
      <button
  onclick="toggleDark()"
  x-data="{ dark: document.documentElement.classList.contains('dark') }"
  x-on:darkmode-changed.window="dark = document.documentElement.classList.contains('dark')"
  :class="dark ? 'bg-slate-700' : 'bg-amber-400'"
  class="relative inline-flex h-7 w-14 items-center rounded-full transition-colors duration-300 cursor-pointer border-0 p-0"
  role="switch"
  title="Toggle dark mode"
>
  <span
    class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-white shadow transition-transform duration-300"
    :class="dark ? 'translate-x-8' : 'translate-x-1'"
  >
    <svg x-show="!dark" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 text-amber-500">
      <path d="M12 2a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1zm0 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm7-4a1 1 0 1 1 0-2h1a1 1 0 1 1 0 2h-1zm-14 0a1 1 0 1 1 0-2H4a1 1 0 1 1 0 2H3zm1.22-7.364a1 1 0 1 1 1.414-1.414l.707.707A1 1 0 0 1 4.927 6.05l-.707-.707zm13.436 0l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 1.414zM12 20a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zm5.657-3.05a1 1 0 1 1 1.414 1.414l-.707.707a1 1 0 0 1-1.414-1.414l.707-.707zm-11.9 1.414a1 1 0 1 1 1.414-1.414l.707.707a1 1 0 1 1-1.414 1.414l-.707-.707z"/>
    </svg>
    <svg x-show="dark" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 text-slate-700">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </span>
</button>
      <form method="post" action="/logout" class="m-0">
        <button type="submit" class="px-3.5 py-2 rounded-lg bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-blue-50 dark:hover:bg-slate-700 text-sm font-medium">
          Log out
        </button>
      </form>
    <% } else { %>
      <a href="/login" class="text-blue-600 dark:text-blue-400 font-semibold no-underline hover:underline">Log in</a>
    <% } %>

    
  </div>
</nav>
<main class="max-w-5xl mx-auto"><%- body %></main>
</div>
</body>
</html>