<%
  const user = session.authenticatedUser;
  const isOrganizer = user && (user.role === "admin" || user.role === "staff");
  const calendarEvents = (typeof upcomingEvents !== "undefined" ? upcomingEvents : [])
    .slice()
    .sort((a, b) => new Date(a.startDatetime).getTime() - new Date(b.startDatetime).getTime());
  const today = new Date();
  const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
  const monthEnd = new Date(today.getFullYear(), today.getMonth() + 1, 0);
  const firstCalendarDay = new Date(monthStart);
  firstCalendarDay.setDate(monthStart.getDate() - monthStart.getDay());
  const monthLabel = today.toLocaleString("en-US", { month: "long", year: "numeric" });
  const weekdayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const eventColors = [
    "bg-sky-500",
    "bg-teal-500",
    "bg-amber-500",
    "bg-rose-500",
  ];
  const eventsByDate = calendarEvents.reduce((grouped, event, index) => {
    const eventDate = new Date(event.startDatetime);
    const key = eventDate.toISOString().slice(0, 10);
    if (!grouped[key]) {
      grouped[key] = [];
    }
    grouped[key].push({ ...event, markerColor: eventColors[index % eventColors.length] });
    return grouped;
  }, {});
%>

<section class="mb-5 overflow-hidden rounded-2xl border border-sky-200 dark:border-sky-900/70 bg-gradient-to-br from-sky-100 via-white to-amber-100 dark:from-slate-900 dark:via-slate-900 dark:to-teal-950 shadow-lg shadow-sky-100/70 dark:shadow-black/30">
  <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr]">
    <div class="p-6 sm:p-8">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/60 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700 dark:text-teal-300">
        <span class="h-2 w-2 rounded-full bg-teal-500 shadow-[0_0_0_4px_rgba(20,184,166,0.16)]"></span>
        <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %> workspace
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-3">
        Welcome back, <%= user.displayName %>.
      </h1>
      <p class="max-w-2xl text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
        Keep the team calendar moving with upcoming events, saved plans, organizer tools, and the archive all in one place.
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="/events" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-4 py-2 font-semibold text-white no-underline shadow-sm transition-colors hover:bg-sky-700 dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5c0-1.1-.89-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/>
          </svg>
          Browse events
        </a>
        <% if (isOrganizer) { %>
        <a href="/events/new" class="inline-flex items-center gap-2 rounded-xl border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/60 px-4 py-2 font-semibold text-teal-700 dark:text-teal-200 no-underline transition-colors hover:bg-teal-100 dark:hover:bg-teal-900/60">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
          </svg>
          Create event
        </a>
        <% } else { %>
        <a href="/profile/saved" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/50 text-amber-800 dark:text-amber-200 font-semibold no-underline hover:bg-amber-100 dark:hover:bg-amber-900/60 transition-colors">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
          Saved events
        </a>
        <% } %>
      </div>
    </div>

    <div class="border-t border-sky-200 bg-white/85 p-6 dark:border-sky-900/70 dark:bg-slate-900/80 sm:p-8 lg:border-l lg:border-t-0">
      <form
        method="GET"
        action="/events"
        class="mb-5"
      >
        <label for="home-query" class="mb-2 block text-sm font-semibold text-teal-800 dark:text-teal-200">Find an event</label>
        <div class="flex gap-2">
          <input
            id="home-query"
            type="text"
            name="query"
            maxlength="100"
            placeholder="Search by topic or location"
            class="min-w-0 flex-1 rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-4 py-2 text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
          />
          <button type="submit" class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-teal-600 text-white shadow-sm transition-colors hover:bg-teal-700 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400" title="Search events">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path d="M9.5 3a6.5 6.5 0 0 1 5.2 10.4l5.45 5.45-1.4 1.4-5.45-5.45A6.5 6.5 0 1 1 9.5 3zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z"/>
            </svg>
          </button>
        </div>
      </form>

      <div class="grid grid-cols-2 gap-3">
        <a href="/events?timeframe=week" class="rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md dark:hover:border-sky-800">
          <span class="block text-2xl font-bold text-sky-700 dark:text-sky-300">7d</span>
          <span class="text-sm text-slate-600 dark:text-slate-300">This week</span>
        </a>
        <a href="/events?timeframe=weekend" class="rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-md dark:hover:border-amber-800">
          <span class="block text-2xl font-bold text-amber-800 dark:text-amber-200">Sat</span>
          <span class="text-sm text-amber-700/80 dark:text-amber-300/80">Weekend</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Pass calendar events to Alpine -->
<script>
  const calendarEventData = <%- JSON.stringify(calendarEvents) %>;
</script>

<section
  class="mt-5 rounded-2xl border border-teal-200 dark:border-teal-900/70 bg-gradient-to-br from-white via-teal-50/70 to-amber-50/70 dark:from-slate-900 dark:via-teal-950/20 dark:to-amber-950/20 p-5 shadow-md shadow-teal-100/70 dark:shadow-black/30 sm:p-6"
  x-data="{
    selectedDate: null,
    selectedLabel: '',
    selectedEvents: [],
    openDay(key, label, events) {
      this.selectedDate = key;
      this.selectedLabel = label;
      this.selectedEvents = events;
    },
    close() { this.selectedDate = null; }
  }"
>
  <div class="flex items-start justify-between gap-3 flex-wrap mb-5">
    <div>
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-1">Upcoming <span class="text-teal-600 dark:text-teal-300">calendar</span></h2>
      <p class="text-sm text-slate-500 dark:text-slate-400 m-0">Published events are marked on the month view.</p>
    </div>
    <a href="/events" class="inline-flex items-center gap-2 rounded-xl border border-sky-200 dark:border-sky-800 bg-white/85 dark:bg-slate-900 px-3 py-1.5 text-sm font-semibold text-sky-700 dark:text-sky-300 no-underline shadow-sm transition-colors hover:bg-sky-50 dark:hover:bg-sky-950">
      View all
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_18rem] gap-5">
    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
      <div class="flex items-center justify-between gap-3 bg-gradient-to-r from-sky-50 via-teal-50 to-amber-50 dark:from-sky-950/30 dark:via-teal-950/20 dark:to-amber-950/20 px-4 py-3 border-b border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white m-0"><%= monthLabel %></h3>
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400"><%= calendarEvents.length %> upcoming</span>
      </div>

      <div class="grid grid-cols-7 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-700">
        <% weekdayLabels.forEach(function(day) { %>
        <div class="px-2 py-2 text-center text-xs font-bold text-slate-500 dark:text-slate-400">
          <%= day %>
        </div>
        <% }) %>
      </div>

      <div class="grid grid-cols-7 bg-white dark:bg-slate-900">
        <% for (let index = 0; index < 42; index++) {
          const date = new Date(firstCalendarDay);
          date.setDate(firstCalendarDay.getDate() + index);
          const key = date.toISOString().slice(0, 10);
          const dayEvents = eventsByDate[key] || [];
          const isCurrentMonth = date.getMonth() === today.getMonth();
          const isToday = date.toDateString() === today.toDateString();
          const dateLabel = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
        %>
        <button
          type="button"
          @click="<%= dayEvents.length > 0 ? `openDay('${key}', '${dateLabel}', calendarEventData.filter(e => e.startDatetime.slice(0,10) === '${key}'))` : '' %>"
          class="min-h-20 w-full text-left p-2 border-r border-b border-slate-100 dark:border-slate-800
            <%= isCurrentMonth ? 'bg-white dark:bg-slate-900' : 'bg-slate-50 dark:bg-slate-950/40' %>
            <%= dayEvents.length > 0 ? 'hover:bg-sky-50 dark:hover:bg-sky-950/20 cursor-pointer' : 'cursor-default' %>"
          aria-label="<%= dayEvents.length > 0 ? `${dayEvents.length} event${dayEvents.length === 1 ? '' : 's'} on ${date.toLocaleDateString('en-US')}` : date.toLocaleDateString('en-US') %>"
        >
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-full text-sm font-semibold <%= isToday ? 'bg-rose-500 text-white' : isCurrentMonth ? 'text-slate-700 dark:text-slate-200' : 'text-slate-300 dark:text-slate-600' %>">
            <%= date.getDate() %>
          </span>

          <% if (dayEvents.length > 0) { %>
          <div class="mt-2 space-y-1">
            <% dayEvents.slice(0, 2).forEach(function(event) { %>
            <div class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full <%= event.markerColor %> shrink-0"></span>
              <span class="truncate text-[11px] font-semibold text-slate-700 dark:text-slate-200"><%= event.title %></span>
            </div>
            <% }) %>
            <% if (dayEvents.length > 2) { %>
            <span class="block text-[11px] font-semibold text-sky-700 dark:text-sky-300">+<%= dayEvents.length - 2 %> more</span>
            <% } %>
          </div>
          <% } %>
        </button>
        <% } %>
      </div>
    </div>

    <aside class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950/40 p-4">
      <h3 class="text-sm font-bold uppercase text-slate-500 dark:text-slate-400 mb-3">Next events</h3>
      <% if (calendarEvents.length === 0) { %>
      <p class="text-sm text-slate-500 dark:text-slate-400 m-0">No upcoming published events yet.</p>
      <% } else { %>
      <div class="space-y-3">
        <% calendarEvents.slice(0, 5).forEach(function(event, index) { %>
        <a href="/events/<%= event.id %>" class="block rounded-xl border border-white dark:border-slate-800 bg-white dark:bg-slate-900 p-3 no-underline transition-all hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md dark:hover:border-sky-800">
          <div class="flex items-center gap-2 mb-1">
            <span class="h-2.5 w-2.5 rounded-full <%= eventColors[index % eventColors.length] %>"></span>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
              <%= new Date(event.startDatetime).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %>
            </span>
          </div>
          <span class="block text-sm font-semibold text-slate-900 dark:text-white"><%= event.title %></span>
          <span class="block text-xs text-slate-500 dark:text-slate-400 mt-1"><%= event.location %></span>
        </a>
        <% }) %>
      </div>
      <% } %>
    </aside>
  </div>

  <!-- Backdrop -->
  <div
    x-show="selectedDate !== null"
    x-transition.opacity
    x-cloak
    @click="close()"
    class="fixed inset-0 bg-black/40 z-40"
  ></div>

  <!-- Day pop-up modal -->
  <div
    x-show="selectedDate !== null"
    x-transition
    x-cloak
    class="fixed z-50 bottom-0 left-0 right-0 sm:bottom-auto sm:top-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 sm:max-w-md w-full rounded-t-2xl sm:rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl p-6"
  >
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white" x-text="selectedLabel"></h3>
      <button @click="close()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-2xl leading-none">&times;</button>
    </div>

    <div class="space-y-3">
      <template x-for="event in selectedEvents" :key="event.id">
        <a
          :href="`/events/${event.id}`"
          class="flex items-start gap-3 rounded-xl border border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 no-underline hover:border-sky-200 dark:hover:border-sky-800 transition-colors"
        >
          <div class="mt-1 h-2.5 w-2.5 rounded-full bg-sky-500 shrink-0"></div>
          <div>
            <span class="block font-semibold text-slate-900 dark:text-white text-sm" x-text="event.title"></span>
            <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5" x-text="new Date(event.startDatetime).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) + ' · ' + event.location"></span>
          </div>
        </a>
      </template>
    </div>
  </div>
</section>

<% if (pageError) { %>
<%- include("partials/error", { message: pageError }) %>
<% } %>

<section
  class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-5"
  x-data="{ focus: '<%= isOrganizer ? "organize" : "attend" %>' }"
>
  <div class="p-5 rounded-2xl border border-teal-200 dark:border-teal-900/70 bg-gradient-to-br from-white via-teal-50/70 to-amber-50/70 dark:from-slate-900 dark:via-teal-950/20 dark:to-amber-950/20 shadow-md shadow-teal-100/70 dark:shadow-black/30">
    <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-1"><span class="text-teal-600 dark:text-teal-300">Quick</span> actions</h2>
