        <span class="block text-sm font-semibold text-slate-900 dark:text-white mb-1">Discover</span>
        <span class="text-sm text-slate-500 dark:text-slate-400">Search published upcoming events.</span>
      </a>
      <a href="/events?timeframe=week" class="rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-teal-200 hover:shadow-md dark:hover:border-teal-800">
        <span class="block text-sm font-semibold text-slate-900 dark:text-white mb-1">RSVP</span>
        <span class="text-sm text-slate-500 dark:text-slate-400">Reserve your spot from an event detail page.</span>
      </a>
      <a href="/profile/saved" class="rounded-2xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/30 p-4 no-underline <%= isOrganizer ? 'opacity-60 pointer-events-none' : '' %>">
        <span class="block text-sm font-semibold text-amber-900 dark:text-amber-100 mb-1">Save</span>
        <span class="text-sm text-slate-500 dark:text-slate-400">Keep interesting events close.</span>
      </a>
    </div>

    <div x-show="focus === 'organize'" x-transition class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="<%= isOrganizer ? '/events/new' : '/events' %>" class="rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-teal-200 hover:shadow-md dark:hover:border-teal-800">
        <span class="block text-sm font-semibold text-slate-900 dark:text-white mb-1">Create</span>
        <span class="text-sm text-slate-500 dark:text-slate-400">Build a draft with the event form.</span>
      </a>
