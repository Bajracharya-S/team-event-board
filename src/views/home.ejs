        </span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-amber-500">
          <path d="M12 4l1.41 1.41L8.83 10H20v2H8.83l4.58 4.59L12 18l-7-7 7-7z" transform="rotate(180 12 11)"/>
        </svg>
      </a>
      <% } %>

      <a href="/archive" class="flex items-center justify-between gap-3 rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md dark:hover:border-sky-800">
        <span>
          <span class="block font-semibold text-slate-900 dark:text-white">Open archive</span>
          <span class="text-sm text-slate-500 dark:text-slate-400">Look back at completed and cancelled events.</span>
        </span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-rose-500">
          <path d="M12 4l1.41 1.41L8.83 10H20v2H8.83l4.58 4.59L12 18l-7-7 7-7z" transform="rotate(180 12 11)"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="p-5 rounded-2xl border border-teal-200 dark:border-teal-900/70 bg-gradient-to-br from-white via-teal-50/70 to-amber-50/70 dark:from-slate-900 dark:via-teal-950/20 dark:to-amber-950/20 shadow-md shadow-teal-100/70 dark:shadow-black/30">
    <div class="flex items-center justify-between gap-3 flex-wrap mb-5">
      <div>
        <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-1">Event board <span class="text-teal-600 dark:text-teal-300">flow</span></h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 m-0">Choose a focus to see the next best path.</p>
