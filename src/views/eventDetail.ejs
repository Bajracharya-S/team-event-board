<h1><%= event.title %></h1>
<p><strong>Status:</strong> <span id="event-status-badge-<%= event.id %>"><%= event.status %></span></p>
<p><strong>Category:</strong> <%= event.category %></p>
<p><strong>Location:</strong> <%= event.location %></p>
<p><strong>Description:</strong> <%= event.description %></p>
<p><strong>Start:</strong> <%= event.startDatetime.toLocaleString() %></p>
<p><strong>End:</strong> <%= event.endDatetime.toLocaleString() %></p>
<p><strong>Organizer:</strong> <%= organizerName %></p>
<p><strong>Attending:</strong> 0 / <%= event.capacity ?? 'Unlimited' %></p>

<% if (currentUser.role === 'admin' || event.organizerId === currentUser.userId) { %>
  <div id="event-controls-<%= event.id %>">
    <% if (event.status === 'draft') { %>
      <form
        hx-post="/events/<%= event.id %>/publish"
        hx-target="#event-controls-<%= event.id %>"
        hx-swap="outerHTML"
      >
        <button type="submit">Publish Event</button>
      </form>
    <% } %>
    <% if (event.status === 'published') { %>
      <form
        hx-post="/events/<%= event.id %>/cancel"
        hx-target="#event-controls-<%= event.id %>"
        hx-swap="outerHTML"
      >
        <button type="submit">Cancel Event</button>
      </form>

            <div id="attendee-list">
    <button
      hx-get="/events/<%= event.id %>/attendees/partial"
      hx-target="#attendee-list"
      hx-swap="outerHTML"
      class="px-4 py-2 rounded-lg bg-slate-600 text-white font-medium cursor-pointer hover:bg-slate-700 text-sm"
    >
      View Attendees
    </button>
    </div>
    <% } %><div class="max-w-3xl mx-auto">

  <div class="mb-6">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white m-0"><%= event.title %></h1>
      <span id="event-status-badge-<%= event.id %>" class="
        px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide
        <%= event.status === 'published' ? 'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300' :
            event.status === 'draft'     ? 'bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300' :
                                           'bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300' %>
      "><%= event.status %></span>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 mb-6 flex flex-col gap-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 m-0">Category</p>
        <p class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 m-0"><%= event.category %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 m-0">Location</p>
        <p class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 m-0"><%= event.location %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 m-0">Start</p>
        <p class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 m-0"><%= event.startDatetime.toLocaleString() %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 m-0">End</p>
        <p class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 m-0"><%= event.endDatetime.toLocaleString() %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 m-0">Organizer</p>
        <p class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 m-0"><%= organizerName %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 m-0">Attending</p>
        <p class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 m-0"><%= attendeeCount %> / <%= event.capacity ?? 'Unlimited' %></p>
      </div>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500 m-0">Description</p>
      <p class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 m-0 leading-relaxed"><%= event.description %></p>
    </div>
  </div>

  <% if (currentUser.role === 'admin' || event.organizerId === currentUser.userId) { %>
  <div id="event-controls-<%= event.id %>" class="flex gap-3 mb-6 flex-wrap">
    <% if (event.status === 'draft') { %>
    <form
      hx-post="/events/<%= event.id %>/publish"
      hx-target="#event-controls-<%= event.id %>"
      hx-swap="outerHTML"
    >
      <button type="submit" class="px-4 py-2 rounded-lg bg-green-600 hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600 text-white text-sm font-medium cursor-pointer transition-colors">
        Publish event
      </button>
    </form>
    <% } %>
    <% if (event.status === 'published') { %>
    <form
      hx-post="/events/<%= event.id %>/cancel"
      hx-target="#event-controls-<%= event.id %>"
      hx-swap="outerHTML"
    >
      <button type="submit" class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 text-white text-sm font-medium cursor-pointer transition-colors">
        Cancel event
      </button>
    </form>
    <div id="attendee-list">
      <button
        hx-get="/events/<%= event.id %>/attendees/partial"
        hx-target="#attendee-list"
        hx-swap="outerHTML"
        class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-800 dark:bg-slate-700 dark:hover:bg-slate-600 text-white text-sm font-medium cursor-pointer transition-colors"
      >
        View attendees
      </button>
    </div>
    <% } %>
  </div>
  <% } else { %>
  <div class="flex gap-3 mb-6 flex-wrap">
    <%- include('rsvp/status', { status: currentUserRsvpStatus, attendeeCount: attendeeCount, eventId: event.id }) %>
    <% if (event.status === 'published') { %>
    <div id="save-btn-<%= event.id %>">
      <%- include('saveButton', {
        eventId: event.id,
        isSaved: savedEventIds.includes(event.id)
      }) %>
    </div>
    <% } %>
  </div>
  <% } %>

  <% if (pageError) { %>
  <p class="text-red-500 dark:text-red-400 text-sm mb-4"><%= pageError %></p>
  <% } %>

  <hr class="my-6 border-slate-200 dark:border-slate-700" />

  <section class="max-w-3xl">
    <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-4">Comments</h2>
    <% if (event.status === 'published') { %>
    <div id="comment-errors" class="mb-3"></div>
    <%- include("partials/comment-form", { eventId: event.id }) %>
    <div class="mt-4" id="comments-section">
      <%- include("partials/comment-list", {
        comments,
        currentUserId: currentUser.userId,
        currentUserRole: currentUser.role,
        eventOrganizerId: event.organizerId,
      }) %>
    </div>
    <% } else { %>
    <p class="text-slate-500 dark:text-slate-400 text-sm">Comments are only available for published events.</p>
    <% } %>
  </section>

</div>
  </div>
<% } else { %>
  <div class="flex gap-2">
  <button class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium cursor-pointer hover:bg-blue-700 text-sm">RSVP</button>
  
  <% if (event.status === 'published') { %>

  <div id="save-btn-<%= event.id %>">
    <%- include('saveButton', { 
      eventId: event.id, 
      isSaved: savedEventIds.includes(event.id) 
    }) %>
  </div>
<% } %>
</div>
<% } %>

<% if (pageError) { %>
  <p style="color: red;"><%= pageError %></p>
<% } %>

<% if (event.status === 'published') { %>
  <hr class="my-6 border-slate-200" />
  <section class="max-w-3xl">
    <h2 class="text-xl font-semibold mb-3">Comments</h2>
    <div id="comment-errors" class="mb-3"></div>
    <%- include("partials/comment-form", { eventId: event.id }) %>
    <div class="mt-4" id="comments-section">
      <%- include("partials/comment-list", {
        comments,
        currentUserId: currentUser.userId,
        currentUserRole: currentUser.role,
        eventOrganizerId: event.organizerId,
      }) %>
    </div>
  </section>
<% } else { %>
  <hr class="my-6 border-slate-200" />
  <section class="max-w-3xl">
    <h2 class="text-xl font-semibold mb-2">Comments</h2>
    <p class="text-slate-500 text-sm m-0">Comments are only available for published events.</p>
  </section>
<% } %>
