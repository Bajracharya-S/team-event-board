<div class="max-w-3xl mx-auto px-4 py-8">

  <%# Event Header Card %>
  <div class="overflow-hidden rounded-2xl border border-sky-200 dark:border-sky-900/70 bg-gradient-to-br from-sky-100 via-white to-amber-100 dark:from-slate-900 dark:via-slate-900 dark:to-teal-950 shadow-lg shadow-sky-100/70 dark:shadow-black/30 mb-6">
    <div class="h-2 bg-gradient-to-r from-sky-400 via-teal-400 to-amber-400"></div>
    <div class="p-6">
    <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= event.title %></h1>

      <span
        id="event-status-badge-<%= event.id %>"
        x-data="{ animate: false }"
        x-on:htmx:after-swap.window="animate = true; setTimeout(() => animate = false, 600)"
        x-bind:class="animate ? 'scale-110' : 'scale-100'"
        class="inline-block transition-transform duration-300 px-3 py-1 rounded-full text-sm font-semibold
          <%= event.status === 'published' ? 'bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-200 ring-1 ring-teal-200 dark:ring-teal-800' :
          event.status === 'draft' ? 'bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-200 ring-1 ring-amber-200 dark:ring-amber-800' :
          event.status === 'cancelled' ? 'bg-rose-50 dark:bg-rose-950 text-rose-700 dark:text-rose-200 ring-1 ring-rose-200 dark:ring-rose-900' :
          'bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-200 ring-1 ring-sky-200 dark:ring-sky-800' %>"
      >
        <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-600 dark:text-slate-300">
      <div class="rounded-xl border border-teal-200 dark:border-teal-900 bg-white/80 dark:bg-slate-900/80 px-3 py-2"><span class="font-semibold text-teal-800 dark:text-teal-200">Category:</span> <%= event.category %></div>
      <div class="rounded-xl border border-sky-200 dark:border-sky-900 bg-white/80 dark:bg-slate-900/80 px-3 py-2"><span class="font-semibold text-sky-800 dark:text-sky-200">Location:</span> <%= event.location %></div>
      <div class="rounded-xl border border-teal-200 dark:border-teal-900 bg-white/80 dark:bg-slate-900/80 px-3 py-2"><span class="font-semibold text-teal-800 dark:text-teal-200">Organizer:</span> <%= organizerName %></div>
      <div class="rounded-xl border border-amber-200 dark:border-amber-900 bg-white/80 dark:bg-slate-900/80 px-3 py-2"><span class="font-semibold text-amber-800 dark:text-amber-200">Attending:</span> 0 / <%= event.capacity ?? 'Unlimited' %></div>
      <div
        class="rounded-xl border border-sky-200 dark:border-sky-900 bg-white/80 dark:bg-slate-900/80 px-3 py-2"
        x-data="{ label: '' }"
        x-init="
          const diff = Math.round((new Date('<%= event.startDatetime.toISOString() %>') - new Date()) / 86400000);
          if (diff === 0) label = 'today';
          else if (diff === 1) label = 'tomorrow';
          else if (diff === -1) label = 'yesterday';
          else if (diff > 1) label = 'in ' + diff + ' days';
          else label = Math.abs(diff) + ' days ago';
        "
      >
        <span class="font-semibold text-sky-800 dark:text-sky-200">Start:</span>
        <%= event.startDatetime.toLocaleString() %>
        <span x-text="'(' + label + ')'" class="text-slate-400 text-xs ml-1"></span>
      </div>
      <div class="rounded-xl border border-rose-200 dark:border-rose-900 bg-white/80 dark:bg-slate-900/80 px-3 py-2"><span class="font-semibold text-rose-800 dark:text-rose-200">End:</span> <%= event.endDatetime.toLocaleString() %></div>
    </div>

    <p class="mt-4 rounded-2xl bg-white/80 dark:bg-slate-900/80 px-4 py-3 text-slate-700 dark:text-slate-300 leading-relaxed shadow-sm"><%= event.description %></p>
    </div>
  </div>

  <%# Error message %>
  <% if (pageError) { %>
    <div class="mb-4 rounded-xl border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 px-4 py-3 text-sm text-rose-700 dark:text-rose-300">
      <%= pageError %>
    </div>
  <% } %>

  <%# Controls %>
  <% if (currentUser.role === 'admin' || event.organizerId === currentUser.userId) { %>
    <div id="event-controls-<%= event.id %>" class="mb-6">
      <% if (event.status === 'draft') { %>
        <form
          hx-post="/events/<%= event.id %>/publish"
          hx-target="#event-controls-<%= event.id %>"
          hx-swap="outerHTML"
        >
          <button type="submit" class="rounded-xl bg-teal-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-teal-700 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400 cursor-pointer">
            Publish Event
          </button>
        </form>
      <% } %>
      <% if (event.status === 'published') { %>
        <div class="flex gap-3 flex-wrap">
          <form
            hx-post="/events/<%= event.id %>/cancel"
            hx-target="#event-controls-<%= event.id %>"
            hx-swap="outerHTML"
          >
            <button type="submit" class="rounded-xl bg-rose-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700 dark:bg-rose-500 dark:text-slate-950 dark:hover:bg-rose-400 cursor-pointer">
              Cancel Event
            </button>
          </form>
          <div id="attendee-list">
            <button
              hx-get="/events/<%= event.id %>/attendees/partial"
              hx-target="#attendee-list"
              hx-swap="outerHTML"
              class="inline-flex items-center gap-2 rounded-xl border border-sky-200 dark:border-sky-800 bg-white/85 dark:bg-slate-900 px-4 py-2 text-sm font-semibold text-sky-700 dark:text-sky-300 cursor-pointer shadow-sm transition-colors hover:bg-sky-50 dark:hover:bg-sky-950"
            >
              View Attendees
            </button>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="flex gap-2 mb-6">
      <button class="rounded-xl bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm cursor-pointer transition-colors hover:bg-sky-700 dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400">RSVP</button>
      <% if (event.status === 'published') { %>
        <div id="save-btn-<%= event.id %>">
          <%- include('saveButton', {
            eventId: event.id,
            isSaved: savedEventIds.includes(event.id)
          }) %>
        </div>
      <% } %>
    </div>
  <% } %>

  <%# Comments %>
  <% if (event.status === 'published') { %>
    <hr class="my-6 border-sky-100 dark:border-slate-700" />
    <section class="max-w-3xl">
      <div class="mb-4">
        <h2 class="mb-1 text-xl font-semibold text-slate-900 dark:text-slate-100">Comments</h2>
        <p class="m-0 text-sm text-slate-500 dark:text-slate-400">Questions, updates, and notes from the event community.</p>
      </div>
      <div id="comment-errors" class="mb-3"></div>
      <%- include("partials/comment-form", { eventId: event.id }) %>
      <div class="mt-4" id="comments-section">
        <%- include("partials/comment-list", {
          comments,
          currentUserId: currentUser.userId,
          currentUserRole: currentUser.role,
          eventOrganizerId: event.organizerId,
        }) %>
      </div>
    </section>
  <% } else { %>
    <hr class="my-6 border-sky-100 dark:border-slate-700" />
    <section class="max-w-3xl rounded-2xl border border-teal-200 dark:border-teal-900/70 bg-gradient-to-br from-white via-teal-50/70 to-amber-50/70 dark:from-slate-900 dark:via-teal-950/20 dark:to-amber-950/20 p-5 shadow-md shadow-teal-100/70 dark:shadow-black/30">
      <h2 class="mb-2 text-xl font-semibold text-slate-900 dark:text-slate-100">Comments</h2>
      <p class="m-0 text-sm text-slate-500 dark:text-slate-400">Comments are only available for published events.</p>
    </section>
  <% } %>

</div>
