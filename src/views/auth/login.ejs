<section class="mb-5 p-6 border border-slate-200 dark:border-slate-700 rounded-2xl bg-gradient-to-b from-white to-slate-50 dark:from-slate-900 dark:to-slate-900 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">Sign in</h1>
  <p class="text-slate-500 dark:text-slate-400">
    Log in with one of the demo accounts below to access the application.
  </p>
</section>

<% if (pageError) { %>
<%- include("partials/error", { message: pageError }) %>
<% } %>

<section class="p-6 border border-slate-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-900 shadow-lg">
  <div class="mb-4">
    <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">Log in</h2>
    <p class="text-slate-500 dark:text-slate-400">
      This starter uses three in-memory demo users with hashed passwords so you
      can focus on building your project features.
    </p>
  </div>

  <form class="grid gap-2.5" method="post" action="/login">
    <label for="email" class="text-sm font-medium text-slate-700 dark:text-slate-300">Email</label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="username"
      required
      class="w-full px-3 py-2.5 border border-slate-300 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500 dark:focus:border-blue-500"
    />
    <label for="password" class="text-sm font-medium text-slate-700 dark:text-slate-300">Password</label>
    <input
      id="password"
      name="password"
      type="password"
      autocomplete="current-password"
      required
      class="w-full px-3 py-2.5 border border-slate-300 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 focus:outline-2 focus:outline-blue-500/20 focus:border-blue-500 dark:focus:border-blue-500"
    />
    <button
      type="submit"
      class="mt-1 px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 text-white font-medium cursor-pointer transition-colors"
    >
      Log in
    </button>
  </form>

  <div class="mt-5 pt-5 border-t border-slate-200 dark:border-slate-700">
    <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">Demo users</h3>
    <ul class="list-disc pl-5 space-y-1 text-sm text-slate-700 dark:text-slate-300">
      <li><code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">admin@app.test</code> / <code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">password123</code> / <code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">Admin</code></li>
      <li><code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">staff@app.test</code> / <code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">password123</code> / <code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">Staff</code></li>
      <li><code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">user@app.test</code> / <code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">password123</code> / <code class="bg-slate-100 dark:bg-slate-800 dark:text-slate-300 px-1 rounded">User</code></li>
    </ul>
  </div>
</section>