<div id="save-btn-<%= eventId %>">
  <form 
    hx-post="/events/<%= eventId %>/saveToggle"
    hx-target="#save-btn-<%= eventId %>"
    hx-swap="outerHTML"
  >
    <button 
      type="submit" 
      class="rounded-xl bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-800 ring-1 ring-amber-200 transition-colors hover:bg-amber-200 dark:bg-amber-950 dark:text-amber-200 dark:ring-amber-800 dark:hover:bg-amber-900 cursor-pointer">
      
      <%= isSaved ? 'Unsave' : 'Save' %>
    </button>
  </form>
</div>
