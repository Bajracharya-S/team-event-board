<div
  id="rsvp-section"
  data-rsvp-state="<%= status %>"
  class="rounded-2xl border-2 p-4 backdrop-blur-sm transition-[border-color,background-color,box-shadow,ring-color] duration-500 ease-out"
  x-data='rsvpToggle(<%- JSON.stringify({ eventId: eventId, status: status, attendeeCount: attendeeCount }) %>)'
  x-bind:class="cardClass"
>
  <div
    x-show="uiReady"
    x-transition:enter="transition ease-out duration-[400ms]"
    x-transition:enter-start="opacity-0 translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex min-w-0 flex-1 items-start gap-3 sm:items-center">
      <div
        class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl shadow-inner transition-colors duration-500 ease-out"
        x-bind:class="iconBubbleClass"
        aria-hidden="true"
      >
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
        <svg
          x-show="isGoing"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-75 rotate-[-12deg]"
          x-transition:enter-end="opacity-100 scale-100 rotate-0"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zm8.935-13.087a1 1 0 010 1.414l-9.192 9.192-.009.009a1 1 0 01-1.423-.009l-4.785-4.785a1 1 0 111.414-1.414l4.068 4.069 8.527-8.527a1 1 0 011.42.041z"
            clip-rule="evenodd"
          />
        </svg>
        <svg
          x-show="isWaitlisted"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-75"
          x-transition:enter-end="opacity-100 scale-100"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 0 0 0-1.5h-3.75V6Z"
            clip-rule="evenodd"
          />
        </svg>
        <svg
          x-show="!switchOn"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-75"
          x-transition:enter-end="opacity-100 scale-100"
          class="h-6 w-6 opacity-90"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12 8.25a.75.75 0 0 1 .75.75v3h3a.75.75 0 0 1 0 1.5h-3v3a.75.75 0 0 1-1.5 0v-3h-3a.75.75 0 0 1 0-1.5h3v-3a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
        </svg>
        </div>
      </div>

      <div class="min-w-0 flex-1">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span
            class="text-[11px] font-bold uppercase tracking-widest transition-colors duration-500"
            x-bind:class="isGoing ? 'text-teal-700 dark:text-teal-300' : isWaitlisted ? 'text-amber-800 dark:text-amber-200' : 'text-slate-500 dark:text-slate-400'"
          >
            RSVP
          </span>
          <button
            type="button"
            role="switch"
            x-bind:aria-checked="switchOn"
            aria-label="Toggle RSVP for this event"
            hx-post="/events/<%= eventId %>/rsvp"
            hx-target="#rsvp-section"
            hx-swap="outerHTML"
            class="relative h-9 w-14 shrink-0 cursor-pointer rounded-full px-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 overflow-hidden transition-colors duration-500 ease-out"
            x-bind:class="trackClass"
          >
            <span
              class="absolute z-[1] h-7 w-7 rounded-full bg-white transition-[left] duration-[420ms] ease-[cubic-bezier(0.34,1.45,0.64,1)] will-change-[left]"
              x-bind:class="knobGlowClass"
              x-bind:style="knobInset"
            ></span>
            <span class="sr-only" x-show="switchOn">Cancel RSVP</span>
            <span class="sr-only" x-show="!switchOn">RSVP</span>
          </button>
        </div>

        <div class="relative min-h-[2.5rem] text-sm leading-snug">
          <p
            x-show="isGoing"
            x-transition:enter="transition ease-out duration-300 delay-75"
            x-transition:enter-start="opacity-0 translate-x-1"
            x-transition:enter-end="opacity-100 translate-x-0"
            class="font-semibold text-teal-800 dark:text-teal-200"
          >
            You&#39;re <span class="text-teal-600 dark:text-teal-400">confirmed</span> for this event
          </p>
          <p
            x-show="isWaitlisted"
            x-transition:enter="transition ease-out duration-300 delay-75"
            x-transition:enter-start="opacity-0 translate-x-1"
            x-transition:enter-end="opacity-100 translate-x-0"
            class="font-semibold text-amber-900 dark:text-amber-100"
          >
            On the waitlist &#8212; we&#39;ll open a spot when capacity allows.
          </p>
          <p
            x-show="!switchOn"
            x-transition:enter="transition ease-out duration-300 delay-75"
            x-transition:enter-start="opacity-0 translate-x-1"
            x-transition:enter-end="opacity-100 translate-x-0"
            class="text-slate-600 dark:text-slate-400"
          >
            Not attending yet &#8212; flip the switch to RSVP.
          </p>
        </div>
      </div>
    </div>

    <p
      class="shrink-0 tabular-nums text-sm font-medium tracking-tight text-slate-600 transition-colors duration-500 dark:text-slate-300 sm:text-right"
      x-text="countLine"
    ><%= attendeeCount %> attending</p>
  </div>
</div>

