<div id="rsvp-section" class="rounded-2xl border border-sky-200/80 dark:border-sky-800/80 bg-white/90 dark:bg-slate-900/80 px-4 py-3 shadow-sm">
  <% const isOn = status === "going" || status === "waitlisted";
     const trackClass = status === "going"
      ? "bg-teal-500 dark:bg-teal-600"
      : status === "waitlisted"
        ? "bg-amber-500 dark:bg-amber-600"
        : "bg-slate-300 dark:bg-slate-600"; %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <span class="text-xs font-semibold uppercase tracking-wide text-sky-700 dark:text-sky-300 shrink-0">RSVP</span>
      <button
        type="button"
        role="switch"
        aria-checked="<%= isOn ? 'true' : 'false' %>"
        aria-label="<%= isOn ? 'Remove RSVP' : 'RSVP to this event' %>"
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-section"
        hx-swap="outerHTML"
        class="relative inline-flex h-8 w-14 shrink-0 cursor-pointer items-center rounded-full p-1 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 <%= isOn ? 'justify-end' : 'justify-start' %> <%= trackClass %>"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none inline-block h-6 w-6 rounded-full bg-white shadow-md ring-0"
        ></span>
      </button>
      <span class="text-sm text-slate-700 dark:text-slate-200 min-w-0">
        <% if (status === "going") { %>
          <span class="font-medium text-teal-800 dark:text-teal-200">You&#39;re going</span>
        <% } else if (status === "waitlisted") { %>
          <span class="font-medium text-amber-800 dark:text-amber-200">You&#39;re on the waitlist</span>
        <% } else { %>
          <span class="text-slate-600 dark:text-slate-400">Not RSVPed yet &#8212; flip on to RSVP</span>
        <% } %>
      </span>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 m-0 sm:text-right tabular-nums">
      <%= attendeeCount %> <%= attendeeCount === 1 ? "person" : "people" %> attending
    </p>
  </div>
</div>
