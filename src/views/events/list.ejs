<% if (events.length === 0) { %>
  <section class="rounded-2xl border border-dashed border-sky-300 dark:border-sky-800 bg-gradient-to-br from-sky-50 to-amber-50 dark:from-sky-950/40 dark:to-amber-950/30 p-10 text-center shadow-sm">
    <p class="text-sky-700 dark:text-sky-300 text-lg m-0">No matching events found.</p>
    <p class="text-slate-500 dark:text-slate-400 text-sm mt-2 mb-0">
      Try clearing your search or choosing a different filter.
    </p>
  </section>
  <% } else { %>
  <div class="mb-3 text-sm text-slate-500 dark:text-slate-400">
    Showing <strong class="text-slate-700 dark:text-slate-200"><%= events.length %></strong> result<%= events.length === 1 ? '' : 's' %>
  </div>

  <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none p-0 m-0">
    <% events.forEach(function(event) { %>
    <li id="event-row-<%= event.id %>" class="overflow-hidden rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-md shadow-sky-100/70 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-teal-100/70 dark:shadow-black/30 dark:hover:border-teal-700">
      <div class="h-2 bg-gradient-to-r from-sky-400 via-teal-400 to-amber-400"></div>
      <div class="p-5">
      <div class="flex flex-col gap-4 h-full">

        <div>
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs px-2.5 py-1 rounded-full bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-200 font-semibold ring-1 ring-teal-200 dark:ring-teal-800">
                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
              </span>

              <% if (event.organizerId === currentUser.userId) { %>
              <span class="text-xs px-2.5 py-1 rounded-full bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-200 font-semibold ring-1 ring-sky-200 dark:ring-sky-800">
                Yours
              </span>
              <% } %>

              <% if (savedEventIds && savedEventIds.includes(event.id)) { %>
              <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-200 font-semibold ring-1 ring-amber-200 dark:ring-amber-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="currentColor">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                </svg>
                Saved
              </span>
              <% } %>
            </div>

            <% if (currentUser.role === 'admin' || currentUser.role === 'staff') { %>
              <%- include('../partials/event-publication-toggle', { event, currentUser }) %>
            <% } else { %>
              <span class="text-xs px-2.5 py-1 rounded-full bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-200 font-semibold uppercase tracking-wide shrink-0 ring-1 ring-sky-200 dark:ring-sky-800">
                <%= event.status %>
              </span>
            <% } %>
          </div>

          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
            <a href="/events/<%= event.id %>" class="text-slate-900 dark:text-white no-underline hover:text-sky-600 dark:hover:text-sky-300 transition-colors">
              <%= event.title %>
            </a>
          </h2>

          <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed m-0">
            <%= event.description %>
          </p>
        </div>

        <div class="mt-auto pt-4 border-t border-sky-100 dark:border-slate-700">
          <p class="text-sm text-sky-700 dark:text-sky-300 font-medium mb-2">
            <%= event.location %>
          </p>

          <p class="text-xs text-slate-400 dark:text-slate-500 m-0">
            <%= new Date(event.startDatetime).toLocaleString("en-US", {
              year: "numeric", month: "short", day: "numeric",
              hour: "2-digit", minute: "2-digit"
            }) %>
            <span class="mx-1">&ndash;</span>
            <%= new Date(event.endDatetime).toLocaleString("en-US", {
              year: "numeric", month: "short", day: "numeric",
              hour: "2-digit", minute: "2-digit"
            }) %>
          </p>

          <% if (currentUser.role === 'admin') { %>
          <div class="mt-3 flex justify-end">
            <button
              type="button"
              hx-post="/events/<%= event.id %>/delete"
              hx-confirm="Delete '<%= event.title.replace(/'/g, "\\'") %>'? This will also remove its comments, RSVPs, and saves."
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium border border-rose-200 dark:border-rose-900 text-rose-600 dark:text-rose-300 bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-950 cursor-pointer transition-colors"
              aria-label="Delete event <%= event.title %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
                <path d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
              </svg>
              Delete
            </button>
          </div>
          <% } %>
        </div>

      </div>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
