<% if (events.length === 0) { %>
<section class="p-10 border border-slate-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-900 shadow-sm text-center">
  <p class="text-slate-400 dark:text-slate-500 text-lg m-0">No matching events found.</p>
</section>
<% } else { %>
<div class="mb-3 text-sm text-slate-500 dark:text-slate-400">
  Showing <strong class="text-slate-700 dark:text-slate-200"><%= events.length %></strong> result<%= events.length === 1 ? '' : 's' %>
</div>
<ul class="space-y-3 list-none p-0 m-0">
  <% events.forEach(function(event) { %>
  <li id="event-row-<%= event.id %>" class="p-5 border border-slate-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-900 shadow-sm hover:border-slate-300 dark:hover:border-slate-600 transition-colors">
    <div class="flex items-start justify-between gap-3 flex-wrap">

      <div class="min-w-[240px]">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-1">
          <a href="/events/<%= event.id %>" class="text-slate-900 dark:text-white no-underline hover:underline">
            <%= event.title %>
          </a>
        </h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm m-0 mb-2">
          <%= event.description %>
        </p>
        <div class="flex items-center gap-3 flex-wrap">
          <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium">
            <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
          </span>
          <span class="text-xs text-slate-400 dark:text-slate-500">
            <%= event.location %>
          </span>
          <% if (event.organizerId === currentUser.userId) { %>
          <span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400 font-semibold">
            Yours
          </span>
          <% } %>
        </div>
      </div>

      <div class="text-right shrink-0">
        <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wide">
          <%= event.status %>
        </span>
        <% if (savedEventIds.includes(event.id)) { %>
        <span class="inline-flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400 font-medium mt-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="currentColor">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
          </svg>
          Saved
        </span>
        <% } %>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-2 mb-0">
          <%= new Date(event.startDatetime).toLocaleString("en-US", {
            year: "numeric", month: "short", day: "numeric",
            hour: "2-digit", minute: "2-digit"
          }) %>
          <span class="mx-1">&ndash;</span>
          <%= new Date(event.endDatetime).toLocaleString("en-US", {
            year: "numeric", month: "short", day: "numeric",
            hour: "2-digit", minute: "2-digit"
          }) %>
        </p>
        <% if (currentUser.role === 'admin') { %>
        <div class="mt-2 flex justify-end">
          <button
            type="button"
            hx-post="/events/<%= event.id %>/delete"
            hx-confirm="Delete '<%= event.title.replace(/'/g, "\\'") %>'? This will also remove its comments, RSVPs, and saves."
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 bg-white dark:bg-slate-900 hover:bg-red-50 dark:hover:bg-red-950 cursor-pointer transition-colors"
            aria-label="Delete event <%= event.title %>"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
              <path d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
            </svg>
            Delete
          </button>
        </div>
        <% } %>
      </div>

    </div>
  </li>
  <% }) %>
</ul>
<% } %>