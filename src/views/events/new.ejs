<section class="max-w-2xl mx-auto overflow-hidden rounded-2xl border border-sky-200 dark:border-sky-900/70 bg-gradient-to-br from-sky-100 via-white to-amber-100 dark:from-slate-900 dark:via-slate-900 dark:to-teal-950 shadow-lg shadow-sky-100/70 dark:shadow-black/30">
  <div class="h-2 bg-gradient-to-r from-sky-400 via-teal-400 to-amber-400"></div>
  <div class="p-6">
  <p class="mb-2 inline-flex items-center rounded-full border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/60 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700 dark:text-teal-300">
    Organizer tools
  </p>
  <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Create New Event</h1>

  <% if (formError) { %>
  <div class="mb-4 rounded-xl border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 p-3 text-sm text-rose-700 dark:text-rose-300">
    <%= formError %>
  </div>
  <% } %>

  <form method="post" action="/events" class="space-y-4">
    <div>
      <label for="title" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= formData?.title || '' %>"
        required
        class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      />
    </div>

    <div>
      <label for="description" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">Description</label>
      <textarea
        id="description"
        name="description"
        rows="4"
        required
        class="w-full resize-none rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      ><%= formData?.description || '' %></textarea>
    </div>

    <div>
      <label for="location" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= formData?.location || '' %>"
        required
        class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      />
    </div>

    <div>
      <label for="category" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">Category</label>
      <select
        id="category"
        name="category"
        required
        class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      >
        <option value="">Select a category</option>
        <% categories.forEach(function(cat) { %>
        <option value="<%= cat %>" <%= formData?.category === cat ? 'selected' : '' %>>
          <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
        </option>
        <% }) %>
      </select>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="startTime" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">Start date & time</label>
        <input
          type="datetime-local"
          id="startTime"
          name="startTime"
          value="<%= formData?.startTime || '' %>"
          required
          class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
        />
      </div>
      <div>
        <label for="endTime" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">End date & time</label>
        <input
          type="datetime-local"
          id="endTime"
          name="endTime"
          value="<%= formData?.endTime || '' %>"
          required
          class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
        />
      </div>
    </div>

    <div>
      <label for="capacity" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">Capacity <span class="text-slate-400 dark:text-slate-500 font-normal">(optional)</span></label>
      <input
        type="number"
        id="capacity"
        name="capacity"
        value="<%= formData?.capacity || '' %>"
        min="1"
        placeholder="Leave blank for unlimited"
        class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      />
    </div>

    <button
      type="submit"
      class="w-full rounded-xl bg-gradient-to-r from-sky-600 to-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-sky-100/70 transition-colors hover:from-sky-700 hover:to-teal-700 dark:shadow-black/30 cursor-pointer"
    >
      Create Event
    </button>
  </form>
  </div>
</section>
