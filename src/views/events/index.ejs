<section class="mb-5 overflow-hidden rounded-2xl border border-sky-200 dark:border-sky-900/70 bg-gradient-to-br from-sky-100 via-white to-amber-100 dark:from-slate-900 dark:via-slate-900 dark:to-teal-950 p-6 shadow-lg shadow-sky-100/70 dark:shadow-black/30">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <p class="mb-2 inline-flex items-center rounded-full border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/60 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700 dark:text-teal-300">Local Event Board</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-2">Events</h1>
      <p class="text-slate-600 dark:text-slate-300 m-0 max-w-2xl">
        Search by keyword or filter published upcoming events by category and date.
      </p>
    </div>

    <% if (currentUser.role === 'admin' || currentUser.role === 'staff') { %>
    <a href="/events/new" class="inline-flex items-center justify-center rounded-xl bg-teal-600 px-4 py-2 text-sm font-semibold text-white no-underline shadow-sm transition-colors hover:bg-teal-700 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400">
      + Create event
    </a>
    <% } %>
  </div>
</section>

<section
  class="mb-5 rounded-2xl border border-teal-200 dark:border-teal-900/70 bg-gradient-to-r from-white via-teal-50 to-sky-50 dark:from-slate-900 dark:via-teal-950/40 dark:to-sky-950/30 p-5 shadow-sm"
  x-data="{
    query: '<%= filters.query || '' %>',
    category: '<%= filters.category || '' %>',
    timeframe: '<%= filters.timeframe || 'all' %>',
    hasFilters() {
      return this.query.length > 0 || this.category.length > 0 || this.timeframe !== 'all';
    },
    clearFilters() {
      this.query = '';
      this.category = '';
      this.timeframe = 'all';
      this.$nextTick(() => this.$refs.filterForm.requestSubmit());
    }
  }"
>
  <form
    x-ref="filterForm"
    method="GET"
    action="/events"
    class="grid grid-cols-1 lg:grid-cols-[1fr_auto_auto_auto] gap-3 items-end"
    hx-get="/events"
    hx-target="#event-list"
    hx-swap="innerHTML"
    hx-push-url="true"
  >
    <div class="relative">
      <label for="query" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">
        Search events
      </label>
      <input
        x-model="query"
        hx-trigger="keyup changed delay:400ms"
        type="text"
        id="query"
        name="query"
        value="<%= filters.query || '' %>"
        placeholder="Search title, description, or location"
        maxlength="100"
        class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-4 py-2 pr-10 text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      />
      <button
        x-show="query.length > 0"
        x-cloak
        x-on:click.prevent="query = ''; $nextTick(() => $refs.filterForm.requestSubmit())"
        type="button"
        aria-label="Clear search"
        class="absolute right-3 bottom-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xl leading-none"
      >
        ×
      </button>
    </div>

    <div>
      <label for="category" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">
        Category
      </label>
      <select
        x-model="category"
        hx-trigger="change"
        id="category"
        name="category"
        class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-4 py-2 text-slate-900 dark:text-slate-100 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      >
        <option value="">All categories</option>
        <option value="social">Social</option>
        <option value="educational">Educational</option>
        <option value="volunteer">Volunteer</option>
        <option value="sports">Sports</option>
        <option value="arts">Arts</option>
      </select>
    </div>

    <div>
      <label for="timeframe" class="block text-sm font-semibold text-teal-800 dark:text-teal-200 mb-1">
        Timeframe
      </label>
      <select
        x-model="timeframe"
        hx-trigger="change"
        id="timeframe"
        name="timeframe"
        class="w-full rounded-xl border border-teal-200 dark:border-teal-800 bg-white dark:bg-slate-900 px-4 py-2 text-slate-900 dark:text-slate-100 shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-400 dark:focus:ring-teal-600"
      >
        <option value="all">All upcoming</option>
        <option value="week">This week</option>
        <option value="weekend">This weekend</option>
      </select>
    </div>

    <div class="flex gap-2">
      <button
        type="submit"
        class="rounded-xl bg-teal-600 px-4 py-2 font-semibold text-white shadow-sm transition-colors hover:bg-teal-700 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400"
      >
        Apply
      </button>

      <button
        x-show="hasFilters()"
        x-cloak
        x-on:click.prevent="clearFilters()"
        type="button"
        class="rounded-xl bg-amber-100 px-4 py-2 font-semibold text-amber-800 transition-colors hover:bg-amber-200 dark:bg-amber-950 dark:text-amber-200 dark:hover:bg-amber-900"
      >
        Clear
      </button>
    </div>
  </form>
</section>

<section id="event-list">
  <%- include("list", { events, filters, currentUser, savedEventIds }) %>
</section>
