<section class="mb-6 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-sm">
  <div class="flex items-center justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 m-0">Attendees</h1>
      <a href="/events/<%= eventId %>" class="text-sm text-blue-600 hover:underline no-underline mt-1 inline-block">← Back to event</a>
    </div>
  </div>
</section>

<%
  const groups = [
    { label: 'Attending', key: 'going', bg: 'bg-green-50', border: 'border-green-200', text: 'text-green-700', dot: 'bg-green-500' },
    { label: 'Waitlisted', key: 'waitlisted', bg: 'bg-yellow-50', border: 'border-yellow-200', text: 'text-yellow-700', dot: 'bg-yellow-500' },
    { label: 'Cancelled', key: 'cancelled', bg: 'bg-red-50', border: 'border-red-200', text: 'text-red-700', dot: 'bg-red-400' },
  ]
%>

<div class="border border-slate-200 rounded-2xl bg-white shadow-sm overflow-hidden">
  <% groups.forEach((group, i) => { %>
    <div class="<%= i !== 0 ? 'border-t border-slate-100' : '' %>">
      <div class="flex items-center gap-2 px-5 py-3 <%= group.bg %> border-b <%= group.border %>">
        <span class="w-2 h-2 rounded-full <%= group.dot %>"></span>
        <span class="text-sm font-semibold <%= group.text %>"><%= group.label %></span>
        <span class="ml-auto text-xs font-medium <%= group.text %> opacity-70"><%= attendees[group.key].length %> <%= attendees[group.key].length === 1 ? 'person' : 'people' %></span>
      </div>

      <% if (attendees[group.key].length === 0) { %>
        <p class="px-5 py-4 text-sm text-slate-400 m-0">No one in this group.</p>
      <% } else { %>
        <ul class="divide-y divide-slate-100 list-none p-0 m-0">
          <% attendees[group.key].forEach(entry => { %>
            <li class="flex items-center justify-between px-5 py-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center shrink-0">
                  <span class="text-xs font-bold text-slate-600"><%= entry.displayName.charAt(0).toUpperCase() %></span>
                </div>
                <span class="text-sm font-medium text-slate-800"><%= entry.displayName %></span>
              </div>
              <span class="text-xs text-slate-400">
                <%= entry.rsvpedAt.toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  <% }) %>
</div>