<div class="mb-6 flex items-center gap-4 rounded-2xl border border-sky-200 dark:border-sky-900/70 bg-gradient-to-br from-sky-100 via-white to-amber-100 dark:from-slate-900 dark:via-slate-900 dark:to-teal-950 p-6 shadow-lg shadow-sky-100/70 dark:shadow-black/30">
  <div class="w-12 h-12 min-w-[48px] rounded-xl bg-amber-100 dark:bg-amber-950 flex items-center justify-center ring-1 ring-amber-200 dark:ring-amber-800">
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-amber-500">
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
    </svg>
  </div>
  <div>
    <h1 class="text-xl font-semibold text-slate-900 dark:text-white m-0">Saved events</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 m-0">Your personal collection</p>
  </div>
</div>

<% if (savedEvents.length === 0) { %>
<div class="flex flex-col items-center justify-center py-16 border border-dashed border-sky-300 dark:border-sky-800 rounded-2xl bg-gradient-to-br from-sky-50 to-amber-50 dark:from-sky-950/40 dark:to-amber-950/30 text-center shadow-sm">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-9 h-9 text-amber-400 dark:text-amber-500 mb-3">
    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
  </svg>
  <p class="text-slate-400 dark:text-slate-500 text-sm mb-4">You haven't saved any events yet.</p>
  <a href="/events" class="text-sm font-semibold text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800 bg-white/85 dark:bg-slate-900 rounded-xl px-4 py-2 hover:bg-sky-50 dark:hover:bg-sky-950 transition-colors shadow-sm">Browse events</a>
</div>
<% } else { %>
<div class="flex flex-col gap-3">
  <% savedEvents.forEach(function(s) { %>
  <div class="flex items-center gap-4 overflow-hidden rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md dark:hover:border-sky-800">
    <div class="w-10 h-10 min-w-[40px] rounded-lg bg-amber-50 dark:bg-amber-950 flex items-center justify-center">
      <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-amber-500">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <a href="/events/<%= s.savedEvent.eventId %>" class="text-sm font-semibold text-slate-900 dark:text-white hover:text-sky-600 dark:hover:text-sky-300 no-underline block truncate">
        <%= s.event ? s.event.title : 'Unknown Event' %>
      </a>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 m-0">
        <%= s.event ? s.event.category + ' · ' + s.event.location : '' %>
      </p>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5 m-0">
        Saved <%= s.savedEvent.savedAt.toLocaleString("en-US", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
      </p>
    </div>
    <a href="/events/<%= s.savedEvent.eventId %>" class="flex-shrink-0 text-xs font-semibold text-sky-700 dark:text-sky-300 no-underline border border-sky-200 dark:border-sky-800 bg-sky-50 dark:bg-sky-950/40 rounded-lg px-3 py-1.5 hover:bg-sky-100 dark:hover:bg-sky-950 transition-colors">
      View event →
    </a>
  </div>
  <% }) %>
</div>
<% } %>
