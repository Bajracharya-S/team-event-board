<section class="mb-6 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-sm">
  <div class="flex items-center gap-3">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="w-6 h-6 text-amber-500"
      fill="currentColor"
    >
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
    </svg>
    <div>
      <h1 class="text-2xl font-bold text-slate-900 m-0">Saved Events</h1>
      <p class="text-slate-500 text-sm m-0">Your personal collection</p>
    </div>
  </div>
</section>

<% if (savedEvents.length === 0) { %>
  <section class="p-12 border border-dashed border-slate-300 rounded-2xl bg-white text-center">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="w-10 h-10 text-slate-300 mx-auto mb-3"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
    </svg>
    <p class="text-slate-400 text-base m-0">You haven't saved any events yet.</p>
    <a href="/events" class="inline-block mt-4 text-sm text-blue-600 hover:underline">Browse events</a>
  </section>

<% } else { %>
  <ul class="space-y-3 list-none p-0 m-0">
    <% savedEvents.forEach(function(s) { %>
      <li class="group p-5 border border-slate-200 rounded-2xl bg-white shadow-sm hover:shadow-md hover:border-slate-300 transition-all duration-150">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="w-4 h-4 text-amber-500"
                fill="currentColor"
              >
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <div class="min-w-0">
              
                <a href="/events/<%= s.savedEvent.eventId %>" class="text-base font-semibold text-slate-900 hover:text-blue-600 no-underline truncate block"><%= s.event ? s.event.title : 'Unknown Event' %></a>
                <%= s.event ? s.event.title : 'Unknown Event' %>
              </a>
              <p class="text-slate-500 text-xs m-0 mt-0.5">
                <%= s.event ? s.event.category + ' · ' + s.event.location : '' %>
              </p>
              <p class="text-slate-400 text-xs m-0 mt-0.5">
                Saved <%= s.savedEvent.savedAt.toLocaleString("en-US", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
              </p>
            </div>
          </div>
          
            <a href="/events/<%= s.savedEvent.eventId %>" class="flex-shrink-0 text-xs font-medium text-slate-500 hover:text-blue-600 no-underline border border-slate-200 rounded-lg px-3 py-1.5 hover:border-blue-300 transition-colors">View event →</a>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>