<section class="mb-5 p-6 border border-slate-200 dark:border-slate-700 rounded-2xl bg-gradient-to-b from-white to-slate-50 dark:from-slate-900 dark:to-slate-900 shadow-lg">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-1">Past events</h1>
      <p class="text-slate-500 dark:text-slate-400 m-0">Browse events that have already taken place.</p>
    </div>
    <a href="/home" class="text-blue-600 dark:text-blue-400 font-semibold no-underline hover:underline text-sm">
      &larr; Back to events
    </a>
  </div>
</section>

<section class="mb-5 p-4 border border-slate-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-900 shadow-sm">
  <form
    method="GET"
    action="/archive"
    hx-get="/archive"
    hx-target="#archive-results"
    hx-swap="outerHTML"
    hx-trigger="change from:#category, submit"
    class="flex items-center gap-3 flex-wrap m-0"
  >
    <label for="category" class="text-sm font-medium text-slate-700 dark:text-slate-300">Filter by category:</label>
    <select
      id="category"
      name="category"
      class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm text-slate-700 dark:text-slate-300"
    >
      <option value="" <%= selectedCategory === "" ? "selected" : "" %>>All categories</option>
      <% validCategories.forEach(function(cat) { %>
      <option value="<%= cat %>" <%= selectedCategory === cat ? "selected" : "" %>>
        <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
      </option>
      <% }); %>
    </select>
    <button
      type="submit"
      class="px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 text-white text-sm font-medium cursor-pointer transition-colors"
    >
      Apply
    </button>
    <% if (selectedCategory) { %>
    
      href="/archive"
      hx-get="/archive"
      hx-target="#archive-results"
      hx-swap="outerHTML"
      class="text-sm text-slate-500 dark:text-slate-400 hover:underline"
    >
      Clear filter
    </a>
    <% } %>
  </form>
</section>

<%- include("_results", { events, selectedCategory }) %>