<div id="archive-results">
  <% if (events.length === 0) { %>
  <section class="rounded-2xl border border-dashed border-sky-300 dark:border-sky-800 bg-gradient-to-br from-sky-50 to-amber-50 dark:from-sky-950/40 dark:to-amber-950/30 p-8 text-center shadow-sm sm:p-10">
    <p class="m-0 text-base text-sky-700 dark:text-sky-300 sm:text-lg">
      <% if (selectedCategory) { %>
        No past events found in the <strong class="text-slate-600 dark:text-slate-300"><%= selectedCategory %></strong> category.
      <% } else { %>
        No past events yet.
      <% } %>
    </p>
  </section>
  <% } else { %>
  <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 lg:grid-cols-2">
    <% events.forEach(function(event) { %>
    <li class="overflow-hidden rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-md shadow-sky-100/70 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-teal-100/70 dark:shadow-black/30 dark:hover:border-teal-700">
      <div class="h-2 bg-gradient-to-r from-sky-400 via-teal-400 to-amber-400"></div>
      <div class="flex h-full flex-col justify-between gap-4">
        <div class="p-5 pb-0">
          <div class="mb-3 flex items-start justify-between gap-3">
            <h2 class="m-0 text-lg font-semibold text-slate-900 dark:text-white"><%= event.title %></h2>
            <span class="shrink-0 rounded-full bg-amber-100 dark:bg-amber-950 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800 dark:text-amber-200 ring-1 ring-amber-200 dark:ring-amber-800">
              Past
            </span>
          </div>
          <p class="m-0 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= event.description %></p>
        </div>
        <div class="mx-5 mb-5 flex flex-wrap items-center gap-2 border-t border-sky-100 dark:border-slate-700 pt-3">
            <span class="rounded-full bg-teal-50 dark:bg-teal-950 px-2.5 py-1 text-xs font-semibold text-teal-700 dark:text-teal-200 ring-1 ring-teal-200 dark:ring-teal-800">
              <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
            </span>
            <span class="rounded-full bg-sky-50 dark:bg-sky-950 px-2.5 py-1 text-xs font-medium text-sky-700 dark:text-sky-200 ring-1 ring-sky-200 dark:ring-sky-800">
              <%= event.location %>
            </span>
          <span class="rounded-full bg-rose-50 dark:bg-rose-950 px-2.5 py-1 text-xs font-medium text-rose-700 dark:text-rose-200 ring-1 ring-rose-200 dark:ring-rose-900 sm:ml-auto">
            Ended <%= new Date(event.endDatetime).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %>
          </span>
        </div>
      </div>
    </li>
    <% }); %>
  </ul>
  <% } %>
</div>
