<div id="archive-results">
  <% if (events.length === 0) { %>
  <section class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/80 p-8 text-center shadow-sm sm:p-10">
    <p class="m-0 text-base text-slate-400 dark:text-slate-500 sm:text-lg">
      <% if (selectedCategory) { %>
        No past events found in the <strong class="text-slate-600 dark:text-slate-300"><%= selectedCategory %></strong> category.
      <% } else { %>
        No past events yet.
      <% } %>
    </p>
  </section>
  <% } else { %>
  <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 lg:grid-cols-2">
    <% events.forEach(function(event) { %>
    <li class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/90 dark:bg-slate-900/90 p-5 shadow-sm grayscale-[15%] transition-all hover:-translate-y-0.5 hover:bg-white hover:grayscale-0 dark:hover:bg-slate-800">
      <div class="flex h-full flex-col justify-between gap-4">
        <div>
          <div class="mb-3 flex items-start justify-between gap-3">
            <h2 class="m-0 text-lg font-semibold text-slate-700 dark:text-slate-200"><%= event.title %></h2>
            <span class="shrink-0 rounded-full bg-slate-200 dark:bg-slate-800 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
              Past
            </span>
          </div>
          <p class="m-0 text-sm leading-6 text-slate-500 dark:text-slate-400"><%= event.description %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2 border-t border-slate-200/80 dark:border-slate-700 pt-3">
            <span class="rounded-full bg-white dark:bg-slate-800 px-2.5 py-1 text-xs font-medium text-slate-500 dark:text-slate-400 ring-1 ring-slate-200 dark:ring-slate-700">
              <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
            </span>
            <span class="text-xs text-slate-400 dark:text-slate-500">
              <%= event.location %>
            </span>
          <span class="text-xs text-slate-400 dark:text-slate-500 sm:ml-auto">
            Ended <%= new Date(event.endDatetime).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) %>
          </span>
        </div>
      </div>
    </li>
    <% }); %>
  </ul>
  <% } %>
</div>
