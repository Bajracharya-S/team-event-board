<div id="event-controls-<%= event.id %>" class="mb-6">
  <% if (event.status === 'draft') { %>
    <form
      hx-post="/events/<%= event.id %>/publish"
      hx-target="#event-controls-<%= event.id %>"
      hx-swap="outerHTML"
    >
      <button type="submit" class="rounded-xl bg-teal-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-teal-700 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400 cursor-pointer">
        Publish Event
      </button>
    </form>
  <% } else if (event.status === 'published') { %>
    <form
      hx-post="/events/<%= event.id %>/cancel"
      hx-target="#event-controls-<%= event.id %>"
      hx-swap="outerHTML"
    >
      <button type="submit" class="rounded-xl bg-rose-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700 dark:bg-rose-500 dark:text-slate-950 dark:hover:bg-rose-400 cursor-pointer">
        Cancel Event
      </button>
    </form>
  <% } else { %>
    <p class="text-slate-500 dark:text-slate-400 text-sm">This event has been <%= event.status %>.</p>
  <% } %>
</div>
