<div id="comment-list" class="rounded-2xl border border-teal-200 dark:border-teal-900/70 bg-gradient-to-br from-white via-teal-50/70 to-amber-50/70 dark:from-slate-900 dark:via-teal-950/20 dark:to-amber-950/20 p-4 shadow-md shadow-teal-100/70 dark:shadow-black/30 sm:p-5">
  <% if (comments.length === 0) { %>
  <div class="rounded-xl border border-dashed border-teal-300 dark:border-teal-800 bg-white/80 dark:bg-slate-900/80 px-4 py-8 text-center">
    <p class="m-0 text-sm font-medium text-teal-700 dark:text-teal-300">No comments yet. Be the first to comment.</p>
  </div>
  <% } else { %>
  <ul class="m-0 list-none space-y-3 p-0">
    <% comments.forEach(function(comment) { %>
    <li
      x-data="{ visible: false }"
      x-init="$nextTick(() => visible = true)"
      x-show="visible"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-2 scale-[0.98]"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      class="rounded-2xl border border-sky-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md dark:hover:border-sky-800"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0 flex-1">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br from-sky-500 to-teal-500 text-xs font-bold text-white">
              <%= comment.authorDisplayName.charAt(0).toUpperCase() %>
            </span>
            <p class="m-0 text-sm font-semibold text-slate-900 dark:text-white"><%= comment.authorDisplayName %></p>
            <span class="h-1 w-1 rounded-full bg-amber-300 dark:bg-amber-600"></span>
            <p class="m-0 text-xs text-sky-600 dark:text-sky-300">
              <%= new Date(comment.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
            </p>
          </div>
          <p class="m-0 whitespace-pre-wrap break-words rounded-xl bg-sky-50/80 dark:bg-sky-950/30 px-3 py-2 text-sm leading-6 text-slate-700 dark:text-slate-200"><%= comment.content %></p>
          <p class="sr-only">
            <%= new Date(comment.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
          </p>
        </div>
        <% if (currentUserId === comment.authorId || currentUserRole === "admin" || currentUserId === eventOrganizerId) { %>
        <form
          method="POST"
          action="/comments/<%= comment.id %>/delete"
          hx-post="/comments/<%= comment.id %>/delete"
          hx-target="#comment-list"
          hx-swap="outerHTML"
          class="m-0 shrink-0"
        >
          <input type="hidden" name="eventId" value="<%= comment.eventId %>" />
          <button
            type="submit"
            class="rounded-lg border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 px-3 py-1.5 text-xs font-semibold text-rose-600 transition-colors hover:bg-rose-100 hover:text-rose-700 dark:text-rose-300 dark:hover:bg-rose-950"
          >
            Delete
          </button>
        </form>
        <% } %>
      </div>
    </li>
    <% }); %>
  </ul>
  <% } %>
</div>
