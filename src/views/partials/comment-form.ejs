<div id="comment-form">
  <form
    method="POST"
    action="/events/<%= eventId %>/comments"
    hx-post="/events/<%= eventId %>/comments"
    hx-target="#comment-list"
    hx-swap="outerHTML"
    class="m-0"
  >
    <div class="mb-3">
      <label for="comment-content" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
        Leave a comment
      </label>
      <textarea
        id="comment-content"
        name="content"
        rows="3"
        maxlength="500"
        placeholder="Ask a question or leave a note..."
        class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm text-slate-800 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 resize-none focus:outline-none focus:ring-2 focus:ring-blue-300 dark:focus:ring-blue-700"
      ></textarea>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 m-0">Max 500 characters.</p>
    </div>
    <button
      type="submit"
      class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 text-white text-sm font-medium cursor-pointer transition-colors"
    >
      Post comment
    </button>
  </form>
</div>