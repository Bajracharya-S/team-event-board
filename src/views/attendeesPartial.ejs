<div id="attendee-panel" x-data="{ open: true }">
  <button
    @click="open = !open"
    class="inline-flex items-center gap-2 rounded-xl border border-sky-200 dark:border-sky-800 bg-white/85 dark:bg-slate-900 px-4 py-2 text-sm font-semibold text-sky-700 dark:text-sky-300 cursor-pointer shadow-sm transition-colors hover:bg-sky-50 dark:hover:bg-sky-950"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
      <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
    </svg>
    <span x-text="open ? 'Hide Attendees' : 'View Attendees'">View Attendees</span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
      class="w-3.5 h-3.5 transition-transform duration-200"
      :class="open ? 'rotate-180' : ''"
    >
      <path d="M7 10l5 5 5-5z"/>
    </svg>
  </button>

  <div x-show="open" x-transition class="mt-4 overflow-hidden rounded-2xl border border-teal-200 dark:border-teal-900/70 bg-gradient-to-br from-white via-teal-50/70 to-amber-50/70 dark:from-slate-900 dark:via-teal-950/20 dark:to-amber-950/20 shadow-md shadow-teal-100/70 dark:shadow-black/30">
    <%
      const groups = [
        { label: 'Attending', key: 'going', bg: 'bg-teal-50 dark:bg-teal-950', border: 'border-teal-200 dark:border-teal-800', text: 'text-teal-700 dark:text-teal-300', dot: 'bg-teal-500' },
        { label: 'Waitlisted', key: 'waitlisted', bg: 'bg-amber-50 dark:bg-amber-950', border: 'border-amber-200 dark:border-amber-800', text: 'text-amber-700 dark:text-amber-300', dot: 'bg-amber-500' },
        { label: 'Cancelled', key: 'cancelled', bg: 'bg-rose-50 dark:bg-rose-950', border: 'border-rose-200 dark:border-rose-900', text: 'text-rose-700 dark:text-rose-300', dot: 'bg-rose-400' },
      ]
    %>

    <% groups.forEach((group, i) => { %>
      <div class="<%= i !== 0 ? 'border-t border-slate-100 dark:border-slate-800' : '' %>">
        <div class="flex items-center gap-2 px-5 py-3 <%= group.bg %> border-b <%= group.border %>">
          <span class="w-2 h-2 rounded-full <%= group.dot %>"></span>
          <span class="text-sm font-semibold <%= group.text %>"><%= group.label %></span>
          <span class="ml-auto text-xs font-medium <%= group.text %> opacity-70"><%= attendees[group.key].length %> <%= attendees[group.key].length === 1 ? 'person' : 'people' %></span>
        </div>

        <% if (attendees[group.key].length === 0) { %>
          <p class="px-5 py-4 text-sm text-slate-400 dark:text-slate-500 m-0">No one in this group.</p>
        <% } else { %>
          <ul class="divide-y divide-slate-100 dark:divide-slate-800 list-none p-0 m-0">
            <% attendees[group.key].forEach(entry => { %>
              <li class="flex items-center justify-between px-5 py-3">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-sky-500 to-teal-500 flex items-center justify-center shrink-0">
                    <span class="text-xs font-bold text-white"><%= entry.displayName.charAt(0).toUpperCase() %></span>
                  </div>
                  <span class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= entry.displayName %></span>
                </div>
                <span class="text-xs text-slate-400 dark:text-slate-500">
                  <%= entry.rsvpedAt.toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>
